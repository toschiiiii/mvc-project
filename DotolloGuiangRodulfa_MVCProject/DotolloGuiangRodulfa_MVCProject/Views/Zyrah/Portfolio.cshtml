@{
    ViewData["Title"] = "Zyrah's Portfolio";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Portfolio</title>
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;700&display=swap" rel="stylesheet" />
        <style>
            /* ============================================================
                   THEME SECTION
                ============================================================ */
            :root {
                --bg: #10002b;
                --bg-2: #240046;
                --text: #e0aaff;
                --dim: #c77dff;
                --border: #5a189a;
                --font: 'IBM Plex Mono', monospace;
            }

            [data-theme="light"] {
                --bg: #f3e8ff;
                --bg-2: #e2ccff;
                --text: #1a0040;
                --dim: #6a0dad;
                --border: #bf00ff;
            }

            /* ============================================================
                   RESET
                ============================================================ */
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: var(--font);
                background: var(--bg);
                color: var(--text);
                font-size: 13px;
                line-height: 1.6;
                transition: background 0.35s ease, color 0.35s ease;
            }

            a {
                color: var(--text);
                text-decoration: none;
            }

                a:hover {
                    text-decoration: underline;
                }

            /* ============================================================
                   TICKER — scrolling skill list at the very top +  fav part
                ============================================================ */
            .ticker {
                position: sticky;
                top: 0;
                z-index: 1000;
                height: 31px;
                overflow: hidden;
                border-bottom: 1px solid var(--border);
                padding: 7px 0;
                white-space: nowrap;
                background: var(--bg);
            }

            .ticker-track {
                display: inline-block;
                animation: ticker-scroll 50s linear infinite;
            }

                .ticker-track:hover {
                    animation-play-state: paused;
                }

            @@keyframes ticker-scroll {
                from

            {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }

            }

            .ticker-track span {
                font-size: 11px;
                color: var(--dim);
                margin: 0 28px;
                letter-spacing: 0.08em;
            }

            @@media (prefers-reduced-motion: reduce) {
                .ticker-track

            {
                animation: none;
            }

            }

            /* ============================================================
                   NAVIGATION
                ============================================================ */
            nav {
                position: sticky;
                top: 31px;
                z-index: 999;
                height: 47px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 11px 40px;
                background: var(--bg);
                border-bottom: 1px solid var(--border);
                transition: background 0.35s ease;
            }

            .nav-logo {
                font-size: 12px;
                font-weight: 500;
                letter-spacing: 0.05em;
            }

            .nav-links {
                list-style: none;
                display: flex;
            }

                .nav-links a {
                    display: block;
                    font-size: 11px;
                    color: var(--dim);
                    padding: 5px 16px;
                    border-left: 1px solid var(--border);
                    letter-spacing: 0.06em;
                    transition: color 0.2s ease;
                }

                .nav-links li:last-child a {
                    border-right: 1px solid var(--border);
                }



            .theme-toggle {
                font-family: var(--font);
                font-size: 11px;
                color: var(--dim);
                background: none;
                border: 1px solid var(--border);
                width: 160px;
                height: 29px;
                padding: 5px 14px;
                cursor: pointer;
                letter-spacing: 0.06em;
                text-align: center;
                white-space: nowrap;
                transition: color 0.2s ease, border-color 0.2s ease;
            }



            /* ============================================================
                   LAYOUT WRAPPER
                ============================================================ */
            .wrap {
                max-width: 940px;
                margin: 0 auto;
                padding: 0 40px;
            }

            /* ============================================================
                   SECTIONS
                ============================================================ */
            section {
                padding: 72px 0;
                border-bottom: 1px solid var(--border);
            }

            .section-label {
                font-size: 11px;
                color: var(--dim);
                letter-spacing: 0.14em;
                margin-bottom: 36px;
                display: flex;
                align-items: center;
                gap: 16px;
            }

                .section-label::after {
                    content: '';
                    flex: 1;
                    height: 1px;
                    background: var(--border);
                }

            /* ============================================================
                   HOME
                ============================================================ */
            #home {
                padding-top: 64px;
            }

            /* ============================================================
                   TRAIN SCENE CSS
                ============================================================ */
            .train-scene {
                position: relative;
                overflow: hidden;
                border: 1px solid var(--border);
                margin-bottom: 44px;
                height: 160px;
                background: var(--bg);
                transition: border-color 0.35s ease, background 0.35s ease;
            }

            .train-lbl {
                position: absolute;
                top: 8px;
                left: 12px;
                font-size: 10px;
                color: var(--dim);
                letter-spacing: 0.12em;
                opacity: 0.55;
                z-index: 2;
                pointer-events: none;
            }

            .train-mover {
                position: absolute;
                bottom: 28px;
                white-space: nowrap;
                will-change: transform;
                animation: train-chug 14s linear infinite;
            }

            @@keyframes train-chug {
                from

            {
                transform: translateX(105vw);
            }

            to {
                transform: translateX(-980px);
            }

            }

            .train-pre {
                display: inline-block;
                font-size: 11px;
                line-height: 1.5;
                color: var(--text);
                white-space: pre;
                letter-spacing: 0;
                margin: 0;
                padding: 0;
            }

            .train-ground {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 28px;
                border-top: 1px solid var(--border);
                display: flex;
                align-items: center;
                padding: 0 12px;
                font-size: 10px;
                color: var(--dim);
                opacity: 0.22;
                overflow: hidden;
                white-space: nowrap;
                pointer-events: none;
            }

            @@media (prefers-reduced-motion: reduce) {
                .train-mover

            {
                animation: none;
                transform: translateX(20px);
            }

            }

            .hero-meta-row {
                display: flex;
                flex-wrap: wrap;
                margin-bottom: 28px;
            }

            .hero-meta-cell {
                font-size: 12px;
                color: var(--dim);
                padding: 5px 18px;
                border: 1px solid var(--border);
                margin: 0 -1px -1px 0;
            }

                .hero-meta-cell b {
                    color: var(--text);
                    font-weight: 400;
                }

            .hero-bio {
                font-size: 14px;
                color: var(--dim);
                max-width: 560px;
                line-height: 1.85;
                margin-bottom: 36px;
            }

                .hero-bio strong {
                    color: var(--text);
                    font-weight: 400;
                }

            .hero-cta {
                display: inline-block;
                font-family: var(--font);
                font-size: 12px;
                border: 1px solid var(--border);
                padding: 9px 22px;
                letter-spacing: 0.06em;
                color: var(--text);
                text-decoration: none;
                transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
            }



            /* ============================================================
                   ABOUT
                ============================================================ */
            .archive-row {
                display: grid;
                grid-template-columns: 180px 1fr;
                gap: 0;
                border-top: 1px solid var(--border);
                padding: 14px 0;
                align-items: baseline;
            }

                .archive-row:last-child {
                    border-bottom: 1px solid var(--border);
                }

            .row-key {
                font-size: 11px;
                color: var(--dim);
                letter-spacing: 0.08em;
                padding-right: 24px;
                padding-top: 1px;
            }

            .row-val {
                font-size: 13px;
                line-height: 1.75;
            }

            .skills-wrap {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .skill-pill {
                font-size: 11px;
                border: 1px solid var(--border);
                padding: 3px 11px;
                color: var(--dim);
                letter-spacing: 0.05em;
                transition: color 0.2s ease, border-color 0.2s ease;
            }



            /* ============================================================
                   PROJECTS
                ============================================================ */
            .project-entry {
                display: grid;
                grid-template-columns: 56px 1fr;
                gap: 0 24px;
                border-top: 1px solid var(--border);
                padding: 28px 0;
                transition: background 0.2s ease, box-shadow 0.2s ease;
            }

                .project-entry:last-child {
                    border-bottom: 1px solid var(--border);
                }

            /* ============================================================
                  ARCHIVE FILTERS
                ============================================================ */

            .archive-filters {
                display: flex;
                flex-wrap: wrap;
                gap: 0;
                margin-bottom: 36px;
                border-top: 1px solid var(--border);
                border-bottom: 1px solid var(--border);
            }

            .archive-filter {
                font-family: var(--font);
                font-size: 11px;
                color: var(--dim);
                background: transparent;
                border: none;
                border-right: 1px solid var(--border);
                padding: 9px 16px;
                cursor: pointer;
                letter-spacing: 0.06em;
                transition: color 0.2s ease, background 0.2s ease, text-shadow 0.2s ease;
            }

                .archive-filter:first-child {
                    border-left: 1px solid var(--border);
                }

                .archive-filter.active {
                    color: var(--text);
                    background: var(--bg-2);
                }

                .archive-filter:hover {
                    color: var(--dim);
                    text-shadow: 0 0 8px rgba(199, 125, 255, 0.75), 0 0 18px rgba(199, 125, 255, 0.35);
                }

            .archive-entry {
                transition: opacity 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
            }

            .proj-num {
                font-size: 11px;
                color: var(--dim);
                letter-spacing: 0.1em;
                padding-top: 3px;
            }

            .proj-body {
            }

            .proj-name-row {
                display: flex;
                align-items: baseline;
                flex-wrap: wrap;
                gap: 10px;
                margin-bottom: 8px;
            }

            .proj-name {
                font-size: 15px;
                font-weight: 500;
                letter-spacing: 0.01em;
            }

            .proj-type {
                font-size: 11px;
                color: var(--dim);
            }

            .proj-meta {
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                margin-bottom: 12px;
            }

                .proj-meta span {
                    font-size: 11px;
                    color: var(--dim);
                }

                    .proj-meta span b {
                        color: var(--text);
                        font-weight: 400;
                    }

            .proj-desc {
                font-size: 13px;
                color: var(--dim);
                line-height: 1.75;
                max-width: 580px;
                margin-bottom: 14px;
            }

            .proj-tools {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin-bottom: 14px;
            }

            .proj-tool {
                font-size: 10px;
                border: 1px solid var(--border);
                padding: 2px 9px;
                color: var(--dim);
                letter-spacing: 0.05em;
            }

            .proj-link {
                font-size: 11px;
                color: var(--dim);
                border-bottom: 1px solid var(--border);
                letter-spacing: 0.05em;
            }



            /* ============================================================
                   CONTACT
                ============================================================ */
            .contact-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 64px;
            }

            .contact-note {
                font-size: 13px;
                color: var(--dim);
                line-height: 1.8;
                margin-bottom: 28px;
            }

            .contact-links-list {
            }

            .contact-link-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-top: 1px solid var(--border);
                padding: 12px 0;
                font-size: 12px;
            }

                .contact-link-row:last-child {
                    border-bottom: 1px solid var(--border);
                }

            .cl-label {
                color: var(--dim);
            }

            .cl-val a {
                color: var(--text);
                transition: color 0.2s ease;
            }



            /* FORM */
            .form-row {
                margin-bottom: 22px;
            }

            .form-lbl {
                display: block;
                font-size: 10px;
                color: var(--dim);
                letter-spacing: 0.12em;
                text-transform: uppercase;
                margin-bottom: 9px;
            }

            .form-field,
            .form-area {
                width: 100%;
                background: none;
                border: none;
                border-bottom: 1px solid var(--border);
                padding: 8px 0;
                font-family: var(--font);
                font-size: 13px;
                color: var(--text);
                outline: none;
                transition: border-color 0.25s ease;
            }

                .form-field::placeholder,
                .form-area::placeholder {
                    color: var(--dim);
                    opacity: 0.5;
                }

                .form-field:focus,
                .form-area:focus {
                    border-color: var(--dim);
                }

            .form-area {
                resize: none;
                min-height: 100px;
                line-height: 1.6;
            }

            .form-send {
                font-family: var(--font);
                font-size: 12px;
                letter-spacing: 0.08em;
                color: var(--text);
                background: transparent;
                border: 1px solid var(--border);
                padding: 10px 22px;
                cursor: pointer;
                transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
            }



            /* ============================================================
                   FOOTER
                ============================================================ */
            footer {
                padding: 40px;
                text-align: center;
            }

            .footer-ascii-block {
                font-size: 8.5px;
                line-height: 1.25;
                letter-spacing: 0.02em;
                white-space: pre;
                overflow-x: auto;
                color: var(--dim);
                opacity: 0.35;
                margin-bottom: 20px;
            }

            .footer-text {
                font-size: 11px;
                color: var(--dim);
                line-height: 1.9;
            }


            /* ============================================================
                   DARK MODE HOVERS
                ============================================================ */

            [data-theme="dark"] .hero-cta:hover,
            [data-theme="dark"] .form-send:hover {
                background: var(--dim);
                color: #10002b;
                border-color: var(--dim);
                box-shadow: 0 0 12px rgba(199, 125, 255, 0.85), 0 0 28px rgba(199, 125, 255, 0.4);
                text-decoration: none;
            }

            [data-theme="dark"] .theme-toggle:hover {
                background: var(--dim);
                color: #10002b;
                border-color: var(--dim);
                box-shadow: 0 0 12px rgba(199, 125, 255, 0.85), 0 0 28px rgba(199, 125, 255, 0.4);
            }

            [data-theme="dark"] .nav-links a:hover {
                color: var(--dim);
                text-shadow: 0 0 8px rgba(199, 125, 255, 0.95), 0 0 20px rgba(199, 125, 255, 0.5);
                text-decoration: none;
            }

            [data-theme="dark"] .skill-pill:hover {
                color: var(--dim);
                border-color: var(--dim);
                box-shadow: 0 0 10px rgba(199, 125, 255, 0.85), 0 0 22px rgba(199, 125, 255, 0.4);
                text-shadow: 0 0 8px rgba(199, 125, 255, 0.75);
            }

            [data-theme="dark"] .project-entry:hover {
                background: var(--bg-2);
                box-shadow: 0 0 22px rgba(199, 125, 255, 0.25), inset 0 0 28px rgba(199, 125, 255, 0.04);
            }

            [data-theme="dark"] .proj-link:hover {
                color: var(--dim);
                border-color: var(--dim);
                text-shadow: 0 0 8px rgba(199, 125, 255, 0.95), 0 0 20px rgba(199, 125, 255, 0.5);
                text-decoration: none;
            }

            [data-theme="dark"] .archive-filter:hover {
                color: var(--dim);
                text-shadow: 0 0 8px rgba(123, 44, 191, 0.65), 0 0 18px rgba(123, 44, 191, 0.35);
            }

            [data-theme="dark"] .cl-val a:hover {
                color: var(--dim);
                text-shadow: 0 0 8px rgba(199, 125, 255, 0.95), 0 0 20px rgba(199, 125, 255, 0.5);
                text-decoration: none;
            }

            /* ============================================================
                   LIGHT MODE HOVERS
                ============================================================ */

            [data-theme="light"] .hero-cta:hover,
            [data-theme="light"] .form-send:hover {
                background: var(--text);
                color: var(--bg);
                border-color: var(--text);
                box-shadow: none;
                text-decoration: none;
            }

            [data-theme="light"] .theme-toggle:hover {
                background: var(--text);
                color: var(--bg);
                border-color: var(--text);
                box-shadow: none;
            }

            [data-theme="light"] .nav-links a:hover {
                color: var(--text);
                text-decoration: none;
            }

            [data-theme="light"] .skill-pill:hover {
                background: var(--text);
                color: var(--bg);
                border-color: var(--text);
            }

            [data-theme="light"] .project-entry:hover {
                background: var(--bg-2);
            }

            [data-theme="light"] .proj-link:hover {
                color: var(--dim);
                border-color: var(--dim);
                text-shadow: 0 0 8px rgba(123, 44, 191, 0.65), 0 0 18px rgba(123, 44, 191, 0.35);
                text-decoration: none;
            }

            [data-theme="light"] .archive-filter:hover {
                color: var(--dim);
                text-shadow: 0 0 8px rgba(123, 44, 191, 0.65), 0 0 18px rgba(123, 44, 191, 0.35);
            }

            [data-theme="light"] .archive-filter.active {
                color: var(--text);
                background: var(--bg-2);
            }

            [data-theme="light"] .cl-val a:hover {
                color: var(--dim);
                text-shadow: 0 0 8px rgba(123, 44, 191, 0.65), 0 0 18px rgba(123, 44, 191, 0.35);
                text-decoration: none;
            }

            /* ============================================================
                   RESPONSIVE
                ============================================================ */
            @@media (max-width: 720px) {
                nav

            {
                padding: 11px 20px;
            }

            .nav-links {
                display: none;
            }

            .wrap {
                padding: 0 20px;
            }

            .hero-ascii-title {
                font-size: 7px;
            }

            .archive-row {
                grid-template-columns: 1fr;
            }

            .row-key {
                margin-bottom: 4px;
                border-bottom: none;
            }

            .project-entry {
                grid-template-columns: 1fr;
            }

            .proj-num {
                display: none;
            }

            .contact-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            footer {
                padding: 28px 20px;
            }

            }
        </style>
    </head>
</head>
<body>

    <div style="padding:12px 40px; font-size:12px;">
        <a href="/">Menu</a> |
        <a href="/Home/Profile">Profile</a> |
        <a href="/Home/Portfolio">Portfolio</a>
    </div>

    <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
            <span>HTML</span><span>CSS</span><span>C</span><span>Java</span><span>MySQL</span><span>PostgreSQL</span><span>VB.NET</span>
            <span>Canva</span><span>Adobe Express</span><span>Figma</span>
            <span>Capcut</span><span>Microsoft Clipchamp</span>
            <span>Google Workspace</span><span>Microsoft Office Suite</span><span>Notion</span>
            <span>HTML</span><span>CSS</span><span>C</span><span>Java</span><span>MySQL</span><span>PostgreSQL</span><span>VB.NET</span>
            <span>Canva</span><span>Adobe Express</span><span>Figma</span>
            <span>Capcut</span><span>Microsoft Clipchamp</span>
            <span>Google Workspace</span><span>Microsoft Office Suite</span><span>Notion</span>
        </div>
    </div>

    <nav role="navigation" aria-label="Main navigation">
        <div class="nav-logo">+toschi.dev+</div>
        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#archive">Archive</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
        <button class="theme-toggle" onclick="toggleTheme()" id="theme-btn" aria-label="Toggle theme">
            [ light ]
        </button>
    </nav>

    <div class="wrap">

        <section id="home" aria-label="Introduction">
